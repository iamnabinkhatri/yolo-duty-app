# Vercel: both values are required for persistent assignments.
DUTY_SUPABASE_URL=
# A Supabase server secret (sb_secret_...) or legacy service_role key. NEVER public.
DUTY_SUPABASE_SECRET_KEY=
# Optional: your published original site's roster JSON endpoint, if added later.
# Must return { "players": [{ "id": "core-name", "name": "Name" }] }.
YOLO_ROSTER_URL=
# Optional: allow a native client's localhost origin to call the JSON API directly.
# The current native apps open the hosted web page and do not need CORS.
DUTY_ALLOWED_ORIGINS=
